{
  "schema_version": 1,
  "diagram_type": "architecture",
  "meta": {
    "title": "VulnHunter 系统架构",
    "subtitle": "Skills + Headless Agent + Harness",
    "locale": "zh-CN",
    "output": "vulnhunter-architecture.html",
    "repository": {
      "host": "github",
      "owner": "capitalone",
      "name": "VulnHunter"
    },
    "viewBox": [
      960,
      640
    ],
    "legend": {
      "mode": "auto"
    }
  },
  "layout": {
    "mode": "grid",
    "cols": 4,
    "gapX": 28,
    "gapY": 24,
    "cellW": 160,
    "cellH": 72
  },
  "components": [
    {
      "id": "cc",
      "type": "external",
      "label": "Claude Code",
      "sublabel": "Opus",
      "row": 0,
      "col": 1
    },
    {
      "id": "hunt",
      "type": "backend",
      "label": "/vulnhunt",
      "sublabel": "阶段子Agent",
      "row": 1,
      "col": 0
    },
    {
      "id": "fix",
      "type": "backend",
      "label": "/vulnhunter-fix",
      "row": 1,
      "col": 1
    },
    {
      "id": "ver",
      "type": "security",
      "label": "/vulnhunt-fix-verify",
      "sublabel": "只读",
      "row": 1,
      "col": 2
    },
    {
      "id": "agent",
      "type": "backend",
      "label": "vulnhunter-agent",
      "sublabel": "headless SDK",
      "row": 2,
      "col": 1
    },
    {
      "id": "har",
      "type": "backend",
      "label": "Batch Harness",
      "row": 2,
      "col": 0
    },
    {
      "id": "out",
      "type": "database",
      "label": "RESULTS dir",
      "row": 3,
      "col": 1
    },
    {
      "id": "gh",
      "type": "cloud",
      "label": "GitHub Issues",
      "row": 2,
      "col": 3
    }
  ],
  "boundaries": [
    {
      "kind": "region",
      "label": "Skill Pipeline",
      "wraps": [
        "hunt",
        "fix",
        "ver"
      ]
    },
    {
      "kind": "security-group",
      "label": "Verify Envelope",
      "wraps": [
        "ver"
      ]
    }
  ],
  "connections": [
    {
      "from": "har",
      "to": "agent",
      "label": "batch repos"
    },
    {
      "from": "agent",
      "to": "cc",
      "label": "run skill"
    },
    {
      "from": "cc",
      "to": "hunt",
      "label": "dispatch phases"
    },
    {
      "from": "hunt",
      "to": "out",
      "label": "PoC+report"
    },
    {
      "from": "fix",
      "to": "out",
      "label": "PR artifacts",
      "variant": "dashed"
    },
    {
      "from": "ver",
      "to": "out",
      "label": "verdicts"
    },
    {
      "from": "agent",
      "to": "gh",
      "label": "dedup issues"
    }
  ]
}